<template name="ai-result">
  <view wx:if="{{aiTask}}" class="cloud-panel ai-result">
    <text class="section-title-text">{{aiTask.type === 'recognize' ? '衣物识别' : '搭配建议'}} · {{aiTask.status === 'succeeded' ? '已完成' : aiTask.status === 'running' ? '处理中' : aiTask.status === 'unknown' ? '结果未知' : '未成功'}}</text>
    <text wx:if="{{aiTask.status === 'unknown'}}" class="cloud-warning">结果暂未返回，请稍后查看。</text>
    <text wx:if="{{aiTask.status === 'failed'}}" class="muted">本次未取得可用建议，可稍后重试。</text>
    <view wx:if="{{aiTask.result.suggestions}}" class="suggestions"><text class="muted">逐项点“应用”后再保存；不会自动覆盖正在填写的信息。</text>
      <view class="suggestion-row"><text>名称 · {{aiTask.result.suggestions.name || '暂无建议'}}</text><button wx:if="{{screen === 'detail' && selected.id === aiTask.result.garmentId && aiTask.result.suggestions.name}}" data-field="name" bindtap="applySuggestion">应用</button></view>
      <view class="suggestion-row"><text>分类 · {{suggestionCategory}}</text><button wx:if="{{screen === 'detail' && selected.id === aiTask.result.garmentId && aiTask.result.suggestions.category}}" data-field="category" bindtap="applySuggestion">应用</button></view>
      <view class="suggestion-row"><text>颜色 · {{aiTask.result.suggestions.color || '暂无建议'}}</text><button wx:if="{{screen === 'detail' && selected.id === aiTask.result.garmentId && aiTask.result.suggestions.color}}" data-field="color" bindtap="applySuggestion">应用</button></view>
      <button wx:if="{{screen === 'ai'}}" class="secondary-wide" bindtap="openRecognizedGarment">打开对应衣物，查看并应用建议</button>
    </view><button class="secondary-wide" loading="{{aiBusy}}" disabled="{{aiBusy}}" bindtap="queryAiTask">刷新结果</button>
  </view>
</template>
<view class="app-shell cloud-shell" style="padding-top: {{statusBarHeight}}px;">
  <view class="cloud-header"><image src="{{assets.imgSprout}}" mode="aspectFit" /><text>小猪猪衣橱</text><text class="cloud-header-tag">家庭共享</text></view>
  <scroll-view class="cloud-scroll" scroll-y>
    <view class="page-content">
      <view class="cloud-sync"><text>{{syncLabel}}</text><text class="link" bindtap="refresh" wx:if="{{family}}">刷新 ↻</text></view>
      <view wx:if="{{error}}" class="cloud-error"><text>{{error}}</text><text wx:if="{{!ready}}" bindtap="bootstrap" class="link">重试连接</text><text wx:elif="{{family}}" bindtap="refresh" class="link">重新加载</text></view>
      <view wx:if="{{!ready && loading}}" class="loading-preview">
        <text class="title-xl">正在打开你的衣橱</text><text class="muted">正在同步最新衣物…</text>
        <view class="loading-members"><view></view><view></view><view></view></view>
        <view class="garment-grid"><view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="loading-card"><view class="loading-photo"></view><view class="loading-line"></view></view></view>
      </view>

      <block wx:if="{{ready && !family}}">
        <view class="intro"><text class="title-xl">一家人的衣物，<text>一起好好照顾</text></text><text class="muted">用各自的微信，走进同一个家庭衣橱。</text></view>
        <view class="cloud-welcome"><image src="{{assets.imgSprout}}" mode="aspectFit" /><text>先为衣物安一个家</text><text class="muted">同一家庭可以共同查看、添加、编辑和删除衣物。不同家庭的数据彼此独立。</text></view>
        <button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="createFamily">创建我的家庭</button>
        <view class="section-title"><text>已有家人创建了家庭？</text></view>
        <view class="cloud-panel"><text class="cloud-label">粘贴家人发来的邀请码</text><textarea class="invite-input" maxlength="64" value="{{inviteInput}}" bindinput="inviteInput" placeholder="邀请码" /><button class="secondary-wide" loading="{{saving}}" disabled="{{saving || !inviteInput}}" bindtap="previewInvite">查看邀请</button><view wx:if="{{invitePreview}}" class="invite-preview"><text>邀请你加入「{{invitePreview}}」</text><text class="muted">所有有效家人均可编辑、删除全部家庭衣物。</text><button class="primary-button" disabled="{{saving}}" bindtap="acceptInvite">确认加入家庭</button></view></view>
      </block>

      <block wx:if="{{ready && family && (screen === 'wardrobe' || screen === 'trash')}}">
        <view wx:if="{{screen === 'trash'}}" class="cloud-back link" data-screen="account" bindtap="nav">‹ 返回我的家庭</view>
        <view class="intro"><text class="title-xl">{{screen === 'trash' ? '留一段，反悔的时间' : '把日常，收拾得刚刚好'}}</text><text class="muted">{{screen === 'trash' ? '删除后保留30天，永久删除后无法恢复。' : family.name + ' · 每件衣物有归处。'}}</text></view>
        <view class="member-line"><view class="member-current"><view class="avatar">{{selectedMemberName[0]}}</view><text>{{selectedMemberName}}的衣橱</text></view><text class="tiny muted">家人一起管理</text></view>
        <view class="chip-row member-chips"><view class="chip {{!selectedMember ? 'chip-active' : ''}}" data-id="" bindtap="chooseMember">全家</view><view wx:for="{{members}}" wx:key="id" class="chip {{selectedMember === item.id ? 'chip-active' : ''}}" data-id="{{item.id}}" bindtap="chooseMember">{{item.name}}</view></view>
        <view class="chip-row categories"><view class="chip {{category === 'all' ? 'chip-active' : ''}}" data-category="all" bindtap="filterCategory">全部</view><view class="chip {{category === 'onepiece' ? 'chip-active' : ''}}" data-category="onepiece" bindtap="filterCategory">整装</view><view class="chip {{category === 'hat' ? 'chip-active' : ''}}" data-category="hat" bindtap="filterCategory">帽子</view><view class="chip {{category === 'top' ? 'chip-active' : ''}}" data-category="top" bindtap="filterCategory">上衣</view><view class="chip {{category === 'bottom' ? 'chip-active' : ''}}" data-category="bottom" bindtap="filterCategory">裤子</view></view>
        <view class="cloud-search"><input class="search-input" value="{{search}}" data-field="search" bindinput="filterInput" bindconfirm="applyFilters" placeholder="搜索名称、备注" confirm-type="search" /><button class="search-submit" bindtap="applyFilters">搜索</button><text class="link" bindtap="toggleFilters">筛选</text></view>
        <view wx:if="{{filtersOpen}}" class="cloud-panel cloud-form">
          <view><text>颜色</text><input maxlength="40" data-field="filterColor" value="{{filterColor}}" bindinput="filterInput" placeholder="例如：白色" /></view>
          <view class="button-row"><button class="secondary-button" bindtap="clearFilters">清空条件</button><button class="secondary-button" bindtap="applyFilters">应用筛选</button></view>
        </view>
        <view class="section-title wardrobe-heading"><text class="wardrobe-heading-title">{{screen === 'trash' ? '回收站衣物' : selectedMemberName + '的衣橱'}}</text><view wx:if="{{screen !== 'trash'}}" class="wardrobe-heading-actions"><button class="wardrobe-action wardrobe-add" disabled="{{saving}}" bindtap="openUpload">{{batch.length ? '继续录入（' + batch.length + '）' : '＋ 添加衣物'}}</button><button class="wardrobe-action wardrobe-bulk" disabled="{{saving}}" bindtap="toggleSelecting">{{selecting ? '完成选择' : '批量整理'}}</button></view></view>
        <view wx:if="{{selecting || screen === 'trash'}}" class="cloud-panel bulk-toolbar"><text>已选 {{selectedIds.length}} / 20 件</text><view class="button-row"><button wx:if="{{screen !== 'trash'}}" class="secondary-button" disabled="{{!selectedIds.length || saving}}" bindtap="bulkEdit">批量修改</button><button wx:if="{{screen !== 'trash'}}" class="secondary-button danger-text" data-action="batchDelete" disabled="{{!selectedIds.length || saving}}" bindtap="bulkAction">移入回收站</button><button wx:if="{{screen === 'trash'}}" class="secondary-button" data-action="restore" disabled="{{!selectedIds.length || saving}}" bindtap="bulkAction">恢复</button><button wx:if="{{screen === 'trash'}}" class="secondary-button danger-text" data-action="purge" disabled="{{!selectedIds.length || saving}}" bindtap="bulkAction">永久删除</button></view></view>
        <view wx:if="{{!garments.length && !loading && !error}}" class="cloud-empty"><image src="{{assets.imgShirt}}" mode="aspectFit" /><text>{{screen === 'trash' ? '回收站空空的' : '没有符合条件的衣物'}}</text><text class="muted">{{screen === 'trash' ? '已删除衣物会在这里保留30天。' : '调整筛选，或为家人添加一件衣物。'}}</text></view>
        <view class="garment-grid"><view wx:for="{{garments}}" wx:key="id" class="garment-card {{item.checked ? 'garment-selected' : ''}}" data-id="{{item.id}}" bindtap="openGarment"><view class="garment-photo"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" /><text wx:else class="muted">照片暂不可用</text><text wx:if="{{selecting || screen === 'trash'}}" class="selection-mark">{{item.checked ? '✓' : '○'}}</text></view><text class="garment-name">{{item.name}}</text><text class="location">⌾ {{item.location || '尚未设置位置'}}</text><text wx:if="{{item.restoreLabel}}" class="tiny muted">可恢复至 {{item.restoreLabel}}</text></view></view>
        <text wx:if="{{loading}}" class="cloud-loading">正在读取衣橱…</text><button wx:if="{{cursor}}" class="secondary-wide" disabled="{{loading}}" bindtap="loadMore">加载更多</button>
      </block>

      <block wx:if="{{ready && family && (screen === 'upload' || screen === 'detail')}}">
        <view class="cloud-back link" data-screen="wardrobe" bindtap="nav">‹ 返回衣橱</view>
        <view class="intro"><text class="title-xl">{{screen === 'upload' ? '拍张照，把衣物收进来' : '每一件，都好好照顾'}}</text><text wx:if="{{screen === 'detail'}}" class="muted">家人都可以修改衣物信息。</text></view>
        <view wx:if="{{screen === 'upload'}}" class="button-row"><button class="secondary-button" disabled="{{saving || recognizingBatch || batch.length >= 9}}" bindtap="chooseOne">拍照 / 选一张</button><button class="secondary-button" disabled="{{saving || recognizingBatch || batch.length >= 9}}" bindtap="chooseMany">相册批量选图</button></view>
        <scroll-view wx:if="{{screen === 'upload' && batch.length}}" scroll-x class="batch-strip"><view class="batch-strip-inner"><view wx:for="{{batch}}" wx:key="id" class="batch-thumb {{batchIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectBatch"><image src="{{item.path}}" mode="aspectFill" /><text>{{index + 1}} · {{item.status === 'saved' ? '已保存' : item.status === 'saving' ? '保存中' : item.status === 'failed' ? '待重试' : '待填写'}}</text></view></view></scroll-view>
        <view wx:if="{{screen === 'upload'}}" class="cloud-photo"><image wx:if="{{imagePath}}" src="{{imagePath}}" mode="aspectFit" /><view wx:else class="cloud-photo-empty"><image src="{{assets.imgPlus}}" mode="aspectFit" /><text>请拍摄或选择衣物照片</text><text class="tiny muted">仅用于衣物，不上传人物照片</text></view></view>
        <view wx:else class="cloud-photo" bindtap="previewImage"><image wx:if="{{selected.image}}" src="{{selected.image}}" mode="aspectFit" /><text class="tiny muted">点击查看照片</text></view>
        <view wx:if="{{screen === 'upload' && batch[batchIndex].error}}" class="cloud-error">{{batch[batchIndex].error}}</view><text wx:if="{{screen === 'upload' && batch[batchIndex].submittedPatch}}" class="tiny muted">本张已提交，重试沿用原信息和编号。已保存项会跳过；如需修改，请打开已保存衣物。</text>
        <button wx:if="{{screen === 'upload' && batch[batchIndex].canRestart}}" class="secondary-wide" disabled="{{saving}}" bindtap="replaceBatchPhoto">更换本张照片，重新录入（新请求）</button>
        <view wx:if="{{screen === 'upload' && batch.length}}" class="cloud-panel recognition-status">
          <text wx:if="{{batch[batchIndex].recognition.status === 'running'}}">正在识别名称和颜色…</text>
          <text wx:elif="{{batch[batchIndex].recognition.status === 'succeeded'}}">名称和颜色已识别，可直接修改后保存。</text>
          <text wx:elif="{{batch[batchIndex].recognition.status === 'unknown'}}" class="muted">识别结果暂未返回，可稍后查看或手动填写。</text>
          <text wx:elif="{{batch[batchIndex].recognition.error}}" class="muted">{{batch[batchIndex].recognition.error}}</text>
          <text wx:else class="muted">照片准备完成后将自动智能识别名称和颜色，也可手动填写。</text>
          <button wx:if="{{batch[batchIndex].recognition && batch[batchIndex].status !== 'saved' && !batch[batchIndex].submittedPatch && batch[batchIndex].recognition.status !== 'succeeded' && !recognizingBatch}}" class="secondary-wide" disabled="{{saving}}" bindtap="retryBatchRecognition">重查本张识别结果</button>
        </view>
        <view class="cloud-panel cloud-form">
          <view><text>名称</text><input maxlength="60" placeholder="选图后自动识别，也可手动填写" value="{{form.name}}" data-field="name" bindinput="formInput" disabled="{{saving || (screen === 'upload' && batch[batchIndex].submittedPatch)}}" /></view>
          <view><text>归属档案</text><picker range="{{memberNames}}" value="{{form.memberIndex}}" data-field="memberIndex" bindchange="formPicker" disabled="{{saving || (screen === 'upload' && batch[batchIndex].submittedPatch)}}"><text>{{memberNames[form.memberIndex]}} ›</text></picker></view>
          <view><text>分类</text><picker range="{{categoryNames}}" value="{{form.categoryIndex}}" data-field="categoryIndex" bindchange="formPicker" disabled="{{saving || (screen === 'upload' && batch[batchIndex].submittedPatch)}}"><text>{{categoryNames[form.categoryIndex]}} ›</text></picker></view>
          <view><text>颜色</text><input maxlength="40" placeholder="自动识别主颜色，也可手动修改" value="{{form.color}}" data-field="color" bindinput="formInput" disabled="{{saving || (screen === 'upload' && batch[batchIndex].submittedPatch)}}" /></view>
          <view><text>备注</text><input maxlength="500" placeholder="可选" value="{{form.notes}}" data-field="notes" bindinput="formInput" disabled="{{saving || (screen === 'upload' && batch[batchIndex].submittedPatch)}}" /></view>
        </view>
        <text class="tiny muted">保存后，同一家庭的家人均可查看、编辑和删除。</text>
        <button wx:if="{{screen === 'upload' && batch.length > 1}}" class="secondary-wide" disabled="{{saving}}" bindtap="applyBatchDefaults">将本张信息用作本批默认值</button><text wx:if="{{screen === 'upload' && batchProgress}}" class="cloud-loading">{{batchProgress}}</text>
        <button class="primary-button" loading="{{saving || (screen === 'upload' && recognizingBatch)}}" disabled="{{saving || (screen === 'upload' && (recognizingBatch || recognitionPending))}}" bindtap="saveGarment">{{saving ? '正在保存…' : screen === 'upload' && (recognizingBatch || recognitionPending) ? '正在识别名称和颜色…' : screen === 'upload' ? '保存本批 / 重试未成功项' : '确认并保存'}}</button>
        <button wx:if="{{screen === 'upload' && saving}}" class="secondary-wide" bindtap="pauseBatch">当前张完成后暂停</button><button wx:if="{{screen === 'upload' && batch[batchIndex].status === 'saved'}}" class="secondary-wide" disabled="{{saving}}" bindtap="openBatchSaved">查看已保存衣物</button><button wx:if="{{screen === 'upload' && batch.length}}" class="cloud-danger" disabled="{{saving}}" bindtap="clearBatch">结束本批，清除本地暂存</button>
        <block wx:if="{{screen === 'detail'}}"><button class="secondary-wide" loading="{{aiBusy}}" disabled="{{aiBusy || saving}}" bindtap="recognizeSelected">重新智能识别这件衣物</button><template is="ai-result" data="{{aiTask,aiBusy,screen,selected,suggestionCategory}}" /><view wx:if="{{pendingAi}}" class="cloud-panel"><text class="tiny muted">上次结果暂未返回，可稍后查看。</text><button class="secondary-wide" disabled="{{aiBusy}}" bindtap="retryAi">查看上次结果</button><button class="secondary-wide" disabled="{{aiBusy}}" bindtap="newAiTask">重新生成</button></view><button class="secondary-wide" loading="{{saving}}" disabled="{{saving}}" bindtap="cutoutSelected">智能去背景·预览透明PNG</button><view wx:if="{{cutoutPath}}" class="cloud-panel"><image class="cutout-preview" src="{{cutoutPath}}" mode="aspectFit" bindtap="previewCutout" /><button class="secondary-wide" loading="{{saving}}" disabled="{{saving || !cutoutRequestId}}" bindtap="replaceOriginal">替换原图</button></view><button class="cloud-danger" disabled="{{saving}}" bindtap="deleteGarment">移入家庭回收站</button></block>
      </block>

      <block wx:if="{{ready && family && screen === 'outfits'}}">
        <view class="intro"><text class="title-xl">今天，也好好穿</text><text class="muted">从真实衣物中组合，收藏全家的日常灵感。</text></view>
        <view class="chip-row member-chips"><view class="chip {{!selectedMember ? 'chip-active' : ''}}" data-id="" bindtap="chooseMember">全家</view><view wx:for="{{members}}" wx:key="id" class="chip {{selectedMember === item.id ? 'chip-active' : ''}}" data-id="{{item.id}}" bindtap="chooseMember">{{item.name}}</view></view>
        <view class="button-row"><button class="secondary-button" bindtap="newOutfit">手动创建搭配</button><button class="secondary-button" bindtap="openAi">智能 搭配助手</button></view><text class="tiny muted">收藏即保存到本页，全家都可查看、修改。</text>
        <view wx:if="{{!outfits.length && !loading}}" class="cloud-empty">还没有收藏搭配，先选几件喜欢的衣物吧。</view>
        <view wx:for="{{outfits}}" wx:key="id" class="cloud-panel outfit-card" data-id="{{item.id}}" bindtap="openOutfit"><view class="outfit-photos"><view wx:for="{{item.garments}}" wx:for-item="garment" wx:key="id"><image wx:if="{{garment.image}}" src="{{garment.image}}" mode="aspectFit" /><text wx:else class="tiny muted">照片不可用</text></view></view><text class="section-title-text">{{item.name}}{{item.partial ? ' · 局部搭配' : ''}}</text><text class="muted">{{item.occasion || '日常'}} · {{item.reason || '点开查看、替换或编辑'}}</text><text wx:if="{{!item.valid}}" class="cloud-warning">部分衣物已改变或不可用，保留原组合供查看</text></view>
        <text wx:if="{{loading}}" class="cloud-loading">正在读取搭配…</text><button wx:if="{{outfitCursor}}" class="secondary-wide" disabled="{{loading}}" bindtap="moreOutfits">更多搭配</button>
      </block>

      <block wx:if="{{ready && family && screen === 'outfitEdit'}}">
        <view class="cloud-back link" data-screen="outfits" bindtap="nav">‹ 返回收藏搭配</view><view class="intro"><text class="title-xl">把喜欢，搭在一起</text><text class="muted">完整搭配需整装，或上衣与裤子，可加帽子。每类一件。</text></view>
        <view class="cloud-panel cloud-form"><view><text>搭配名称</text><input maxlength="60" value="{{outfitForm.name}}" data-field="name" bindinput="outfitInput" placeholder="例如：周末散步" /></view><view><text>归属成员</text><picker range="{{memberNames}}" bindchange="outfitMember"><text>{{outfitMemberName || '选择成员'}} ›</text></picker></view><view><text>场景</text><input maxlength="100" value="{{outfitForm.occasion}}" data-field="occasion" bindinput="outfitInput" placeholder="例如：通勤、运动" /></view><view><text>搭配说明</text><input maxlength="500" value="{{outfitForm.reason}}" data-field="reason" bindinput="outfitInput" placeholder="可选" /></view><view><text>局部搭配（允许缺件）</text><switch color="#7d926e" checked="{{outfitForm.partial}}" bindchange="outfitPartial" /></view></view>
        <view wx:for="{{outfitPicked}}" wx:key="id" class="cloud-panel picked-garment"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" /><view><text>{{item.name}}</text><text wx:if="{{item.available === false || (item.currentVersion && item.currentVersion !== item.version)}}" class="cloud-warning">衣物已改变或不可用，请重新选择</text></view><text class="link" data-id="{{item.id}}" bindtap="removeOutfitItem">移除</text></view>
        <button class="secondary-wide" disabled="{{saving}}" bindtap="openOutfitPicker">挑选 / 替换真实衣物</button><button class="primary-button" disabled="{{saving}}" loading="{{saving}}" bindtap="saveOutfit">{{outfitForm.id ? '保存搭配修改' : '收藏这套搭配'}}</button><button wx:if="{{outfitForm.id}}" class="cloud-danger" disabled="{{saving}}" bindtap="deleteOutfit">删除收藏搭配</button>
      </block>

      <block wx:if="{{ready && family && screen === 'picker'}}">
        <view class="intro"><text class="title-xl">选几件，喜欢的衣物</text><text class="muted">仅当前成员的衣物。点同类新品可替换，再点可移除。</text></view><text class="tiny muted">已选 {{pickedIds.length}} / 3 件</text>
        <view class="garment-grid"><view wx:for="{{outfitCandidates}}" wx:key="id" class="garment-card {{item.checked ? 'garment-selected' : ''}}" data-id="{{item.id}}" bindtap="toggleCandidate"><view class="garment-photo"><image src="{{item.image}}" mode="aspectFit" /><text class="selection-mark">{{item.checked ? '✓' : '○'}}</text></view><text class="garment-name">{{item.name}}</text><text class="tiny muted">{{item.categoryLabel}}</text></view></view><text wx:if="{{!outfitCandidates.length && !loading}}" class="cloud-empty">这位成员还没有衣物。</text><button wx:if="{{candidateCursor}}" class="secondary-wide" disabled="{{loading}}" bindtap="moreCandidates">加载更多衣物</button><button class="primary-button" disabled="{{loading}}" bindtap="finishPicker">确认所选衣物</button>
      </block>

      <block wx:if="{{ready && family && screen === 'ai'}}">
        <view class="cloud-back link" data-screen="outfits" bindtap="nav">‹ 返回搭配</view><view class="intro"><text class="title-xl">一点灵感，来自你的衣橱</text><text class="muted">只提供真实衣物建议，不提供人物或真人试穿。</text></view>
        <text wx:if="{{aiStatus && !aiStatus.configured}}" class="muted">智能搭配暂不可用，请稍后再试。</text>
        <view class="cloud-panel cloud-form"><view><text>成员</text><picker range="{{memberNames}}" value="{{aiMemberIndex}}" bindchange="aiMember"><text>{{memberNames[aiMemberIndex] || '请选择'}} ›</text></picker></view><view><text>场景</text><input maxlength="100" placeholder="例如：通勤、周末出游" value="{{aiOccasion}}" data-field="aiOccasion" bindinput="aiInput" /></view><view><text>季节</text><input maxlength="40" placeholder="例如：秋季" value="{{aiSeason}}" data-field="aiSeason" bindinput="aiInput" /></view><view><text>固定单品</text><text class="link" bindtap="openLockPicker">{{lockedNames || '选择真实衣物'}} ›</text></view></view>
        <button class="primary-button" disabled="{{aiBusy || !aiStatus.configured}}" loading="{{aiBusy}}" bindtap="generateRecommendations">生成最多3套搭配（需确认）</button><view wx:if="{{pendingAi}}" class="cloud-panel"><text class="muted">上次结果暂未返回，可稍后查看。</text><button class="secondary-wide" disabled="{{aiBusy}}" bindtap="retryAi">查看上次结果</button><button class="secondary-wide" disabled="{{aiBusy}}" bindtap="newAiTask">重新生成</button></view>
        <template is="ai-result" data="{{aiTask,aiBusy,screen,selected,suggestionCategory}}" />
        <view wx:for="{{recommendations}}" wx:key="index" class="cloud-panel"><view class="outfit-photos"><view wx:for="{{item.garments}}" wx:for-item="garment" wx:key="id"><image src="{{garment.image}}" mode="aspectFit" /><text class="tiny">{{garment.name}}</text></view></view><text>{{item.reason}}</text><text wx:if="{{item.missing}}" class="cloud-warning">部分衣物已不可用，请手动替换。</text><button class="secondary-wide" data-index="{{index}}" bindtap="useRecommendation">查看 / 手动替换后收藏</button></view>
        <view class="section-title"><text>智能 任务历史</text><text class="link" bindtap="refreshAiHistory">刷新</text></view><view class="cloud-panel"><view wx:for="{{aiHistory}}" wx:key="id" class="cloud-list-row" data-id="{{item.id}}" bindtap="openAiTask"><text>{{item.type === 'recognize' ? '衣物识别' : '搭配推荐'}}</text><text class="muted">{{item.status === 'succeeded' ? '已完成' : item.status === 'running' ? '处理中' : item.status === 'unknown' ? '结果未知' : '未成功'}} ›</text></view><text wx:if="{{!aiHistory.length}}" class="muted">还没有任务记录</text></view><button wx:if="{{aiCursor}}" class="secondary-wide" disabled="{{aiBusy}}" bindtap="moreAiHistory">更多历史</button>
      </block>

      <block wx:if="{{ready && family && screen === 'locations'}}">
        <view class="cloud-back link" data-screen="account" bindtap="nav">‹ 返回我的家庭</view><view class="intro"><text class="title-xl">让每一件，有固定归处</text><text class="muted">全家共享两级收纳位置。点位置可改名、移动或删除。</text></view><button class="primary-button" disabled="{{saving}}" bindtap="createLocation">新增一级位置</button><view class="cloud-panel"><view wx:for="{{locations}}" wx:key="id" class="cloud-list-row {{item.parentId ? 'location-child' : ''}}"><text class="location-name" data-id="{{item.id}}" bindtap="editLocation">{{item.parentId ? '↳ ' : ''}}{{item.name}} ›</text><text wx:if="{{!item.parentId}}" class="link" data-parent="{{item.id}}" bindtap="createLocation">＋ 二级</text></view><text wx:if="{{!locations.length}}" class="muted">还没有收纳位置，先加一个衣柜吧。</text></view>
      </block>

      <block wx:if="{{ready && family && screen === 'account'}}">
        <view class="intro"><text class="title-xl">一家的衣物，一起照顾</text><text class="muted">各自微信登录，共享一个家庭衣橱。</text></view>
        <view class="home-card"><view class="avatar">家</view><view><text class="section-title-text">{{family.name}}</text><text class="muted">{{accounts.length}} 位登录家人 · {{members.length}} 个衣物档案</text></view><text wx:if="{{family.role === 'owner'}}" class="link" bindtap="renameFamily">改名</text></view>
        <view class="section-title"><text>衣物归属档案</text><text class="link" bindtap="addMember">＋ 新增</text></view>
        <view class="cloud-panel"><view wx:for="{{members}}" wx:key="id" class="cloud-list-row" data-id="{{item.id}}" bindtap="renameMember"><view class="avatar small">{{item.name[0]}}</view><text>{{item.name}}</text><text class="link">改名 ›</text></view></view><text class="tiny muted">可以为没有微信账号的孩子建立档案。档案用于整理衣物，不授予登录权限。</text>
        <view class="section-title"><text>登录家人</text></view>
        <view class="cloud-panel"><view wx:for="{{accounts}}" wx:key="userId" class="cloud-list-row" data-id="{{item.userId}}" bindtap="manageAccount"><text>{{item.label}}{{item.isSelf ? '（你）' : ''}}</text><text class="tiny muted">{{family.role === 'owner' && !item.isSelf ? '管理 ›' : '已加入'}}</text></view></view>
        <view class="section-title"><text>家庭整理</text></view><view class="cloud-panel"><view class="cloud-list-row" data-screen="trash" bindtap="nav"><text>家庭回收站</text><text class="link">30天可恢复 ›</text></view></view>
        <button class="cloud-danger" disabled="{{saving}}" bindtap="leaveFamily">退出当前家庭</button>
      </block>
      <view class="cloud-help"><text class="link" bindtap="viewPrivacy">隐私保护指引</text></view>
    </view>
  </scroll-view>
  <view wx:if="{{family}}" class="bottom-nav cloud-nav"><view class="nav-item {{screen === 'wardrobe' || screen === 'upload' || screen === 'detail' ? 'active' : ''}}" data-screen="wardrobe" bindtap="nav"><image src="{{assets.imgShirt}}" mode="aspectFit" /><text>衣橱</text></view><view class="nav-item {{screen === 'account' || screen === 'trash' || screen === 'locations' ? 'active' : ''}}" data-screen="account" bindtap="nav"><image src="{{assets.imgUserRound}}" mode="aspectFit" /><text>我的家庭</text></view></view>
  <view wx:if="{{showPrivacy}}" class="privacy-mask"><view class="privacy-dialog"><text class="section-title-text">上传衣物照片前，请阅读</text><text class="muted">为保存衣物并与同一家庭共享，需要使用你选择或拍摄的照片。未保存照片会暂存本机以便继续录入，退出家庭时清除。选图后将自动智能识别名称和颜色。你可以拒绝并继续浏览。</text><text class="link" bindtap="viewPrivacy">{{privacyContractName}}</text><button class="primary-button" id="agree-privacy" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacy">同意并继续选图</button><button class="secondary-wide" bindtap="declinePrivacy">暂不使用</button></view></view>
</view>
