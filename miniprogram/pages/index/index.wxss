page { background: #f8f7f2; }

.app-shell { min-height: 100vh; background: #f8f7f2; color: #29372f; }
.status-bar { height: 68rpx; padding: 0 52rpx; display: flex; align-items: center; justify-content: space-between; }
.status-time { font-size: 26rpx; font-weight: 700; }
.status-icons { display: flex; align-items: center; gap: 10rpx; height: 32rpx; }
.status-icons image { width: 32rpx; height: 32rpx; }
.status-icons .battery { width: 46rpx; }
.mini-nav { height: 88rpx; padding: 0 44rpx; display: flex; align-items: center; justify-content: space-between; }
.brand-row { display: flex; align-items: center; gap: 16rpx; font-weight: 700; font-size: 28rpx; }
.brand-mark { width: 36rpx; height: 36rpx; }
.nav-back { width: 38rpx; height: 38rpx; }
.capsule { border: 1rpx solid #e5e7de; border-radius: 60rpx; width: 170rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; gap: 24rpx; }
.capsule image { width: 34rpx; height: 34rpx; }
.capsule view { width: 1rpx; height: 30rpx; background: #e5e7de; }
.page-scroll { height: calc(100vh - 264rpx); }
.page-content { padding: 36rpx 44rpx 64rpx; }
.intro { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 34rpx; }
.title-xl { font-size: 48rpx; line-height: 1.35; font-weight: 700; letter-spacing: -1rpx; }
.muted { color: #7b8178; }
.tiny { font-size: 20rpx; line-height: 1.5; }
.member-line { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.member-current { display: flex; align-items: center; gap: 12rpx; font-size: 24rpx; font-weight: 600; }
.member-current image { width: 26rpx; height: 26rpx; }
.avatar { background: #eaf0e6; color: #456b53; border-radius: 50%; width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 700; }
.avatar.small { width: 44rpx; height: 44rpx; font-size: 18rpx; }
.avatar.outline { border: 1rpx solid #456b53; background: #f8f7f2; font-weight: 400; }
.member-popover { position: absolute; z-index: 20; left: 44rpx; right: 44rpx; margin-top: -14rpx; padding: 12rpx; background: #fff; border: 1rpx solid #e5e7de; border-radius: 16rpx; box-shadow: 0 10rpx 30rpx rgba(41, 55, 47, .12); }
.member-option { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 12rpx; border-radius: 12rpx; }
.member-option.selected { background: #eaf0e6; color: #456b53; }
.chip-row { display: flex; align-items: center; gap: 14rpx; flex-wrap: wrap; margin-bottom: 24rpx; }
.chip { padding: 14rpx 24rpx; background: #fff; border-radius: 60rpx; color: #7b8178; font-size: 22rpx; white-space: nowrap; }
.chip-active { background: #456b53; color: #fff; font-weight: 700; }
.member-chips { margin-bottom: 30rpx; flex-wrap: nowrap; overflow: hidden; }
.search-box { height: 86rpx; background: #fff; border-radius: 28rpx; padding: 0 24rpx; display: flex; align-items: center; gap: 16rpx; margin-bottom: 30rpx; }
.search-box image { width: 32rpx; height: 32rpx; }
.search-box input { flex: 1; height: 100%; font-size: 22rpx; }
.placeholder { color: #7b8178; }
.summary-card { background: #eaf0e6; border-radius: 28rpx; padding: 28rpx 30rpx; display: flex; align-items: center; justify-content: space-between; margin-bottom: 30rpx; }
.summary-card image { width: 42rpx; height: 42rpx; }
.summary-title { display: block; color: #456b53; font-weight: 700; font-size: 24rpx; margin-bottom: 6rpx; }
.categories { flex-wrap: nowrap; overflow: hidden; margin-bottom: 18rpx; }
.filter-row { display: flex; gap: 40rpx; color: #7b8178; font-size: 22rpx; margin-bottom: 26rpx; }
.garment-grid { display: grid; grid-template-columns: 1fr 1fr; column-gap: 24rpx; row-gap: 28rpx; }
.garment-card { min-width: 0; }
.garment-photo { position: relative; height: 336rpx; background: #f0ede5; border-radius: 28rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.garment-photo image { width: 90%; height: 90%; }
.garment-name { display: block; font-size: 25rpx; font-weight: 500; margin-top: 14rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.location { display: block; font-size: 18rpx; color: #7b8178; margin-top: 8rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.primary-button { min-height: 96rpx; border-radius: 28rpx; background: #456b53; color: #fff; display: flex; align-items: center; justify-content: center; gap: 16rpx; font-size: 28rpx; font-weight: 700; margin-top: 34rpx; }
.primary-button image, .secondary-button image { width: 34rpx; height: 34rpx; }
.primary-button.compact { min-height: 74rpx; margin-top: 0; font-size: 22rpx; border-radius: 22rpx; flex: 1; }
.secondary-button { min-height: 74rpx; padding: 0 20rpx; border-radius: 22rpx; background: #eaf0e6; color: #456b53; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 700; }
.button-row { display: flex; gap: 18rpx; margin-top: 28rpx; }
.secondary-wide { min-height: 82rpx; border-radius: 22rpx; background: #eaf0e6; color: #456b53; display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 700; margin-top: 24rpx; }
.upload-entry-row { display: flex; gap: 18rpx; margin: 30rpx 0; }
.upload-entry { flex: 1; min-height: 104rpx; border-radius: 22rpx; background: #fff; padding: 18rpx; display: grid; grid-template-columns: 34rpx 1fr; grid-template-rows: 1fr 1fr; column-gap: 12rpx; }
.upload-entry image { width: 34rpx; height: 34rpx; grid-row: span 2; align-self: center; }
.upload-entry text:nth-of-type(1) { font-size: 22rpx; color: #29372f; }
.upload-entry text:nth-of-type(2) { color: #7b8178; font-size: 18rpx; }
.progress-title, .favorite-summary, .fitting-tools { display: flex; justify-content: space-between; align-items: center; font-size: 22rpx; margin: 22rpx 0 12rpx; }
.progress-track { height: 6rpx; border-radius: 8rpx; background: #dfe9dc; overflow: hidden; }
.progress-value { height: 100%; border-radius: 8rpx; background: #456b53; }
.upload-thumbs { display: flex; gap: 16rpx; margin: 20rpx 0 28rpx; }
.upload-thumb { width: 148rpx; height: 126rpx; border-radius: 22rpx; background: #f0ede5; border: 1rpx solid transparent; display: flex; justify-content: center; align-items: center; position: relative; }
.upload-thumb.active { border-color: #456b53; }
.upload-thumb > image:first-child { width: 92%; height: 92%; }
.check-icon { position: absolute; top: 10rpx; right: 10rpx; width: 24rpx !important; height: 24rpx !important; }
.section-title { display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; font-weight: 700; margin: 28rpx 0 14rpx; }
.link { color: #456b53; }
.preview-card { position: relative; min-height: 300rpx; background: #f0ede5; border-radius: 28rpx; overflow: hidden; display: flex; align-items: center; justify-content: center; margin: 22rpx 0; }
.preview-image { width: 85%; height: 270rpx; }
.preview-label { position: absolute; left: 22rpx; top: 20rpx; color: #456b53; font-size: 20rpx; display: flex; align-items: center; gap: 8rpx; }
.preview-label image { width: 26rpx; height: 26rpx; }
.source-pill { position: absolute; right: 20rpx; bottom: 18rpx; padding: 10rpx 14rpx; border-radius: 26rpx; background: #fff; font-size: 18rpx; color: #29372f; }
.info-card { background: #fff; border-radius: 26rpx; padding: 12rpx 28rpx; margin-top: 22rpx; }
.info-card > view { display: flex; justify-content: space-between; gap: 20rpx; align-items: center; min-height: 74rpx; border-bottom: 1rpx solid #f0f1ec; font-size: 22rpx; }
.info-card > view:last-child { border-bottom: 0; }
.info-card > view > text:first-child { color: #7b8178; }
.info-card > view > text:last-child { text-align: right; }
.notice-card { display: flex; gap: 12rpx; align-items: flex-start; background: #eaf0e6; border-radius: 16rpx; padding: 20rpx; color: #456b53; font-size: 20rpx; line-height: 1.6; margin-top: 22rpx; }
.notice-card image { width: 28rpx; height: 28rpx; flex: 0 0 auto; }
.foot-note { display: block; color: #7b8178; font-size: 18rpx; margin-top: 18rpx; }
.hero-photo { height: 540rpx; background: #f0ede5; border-radius: 30rpx; position: relative; display: flex; align-items: center; justify-content: center; margin-bottom: 22rpx; overflow: hidden; }
.hero-photo > image { width: 90%; height: 90%; }
.photo-label { position: absolute; left: 22rpx; top: 20rpx; font-size: 20rpx; color: #7b8178; display: flex; gap: 8rpx; align-items: center; }
.photo-label image { width: 28rpx; height: 28rpx; }
.location-card { background: #eaf0e6; border-radius: 28rpx; padding: 28rpx; margin: 24rpx 0; display: flex; flex-direction: column; gap: 10rpx; }
.location-link { color: #456b53; font-size: 22rpx; }
.location-title { font-size: 28rpx; font-weight: 700; }
.outfit-card, .task-card { background: #fff; border: 1rpx solid #e5e7de; border-radius: 34rpx; padding: 28rpx; margin: 20rpx 0; }
.outfit-card.outfit-featured { border-color: #456b53; }
.outfit-heading { display: flex; align-items: center; justify-content: space-between; font-size: 28rpx; font-weight: 700; margin-bottom: 20rpx; }
.outfit-heading .link { font-size: 18rpx; font-weight: 400; }
.outfit-items { display: flex; gap: 14rpx; }
.outfit-item { flex: 1; min-width: 0; text-align: center; display: flex; flex-direction: column; gap: 7rpx; align-items: center; }
.outfit-item > text:first-of-type { font-size: 19rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; }
.outfit-item > text:nth-of-type(2) { font-size: 17rpx; }
.outfit-item > text:last-of-type { font-size: 17rpx; }
.outfit-image { position: relative; height: 150rpx; width: 100%; border-radius: 16rpx; background: #f8f7f2; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.outfit-image image { width: 90%; height: 90%; }
.lock-card { background: #eaf0e6; border-radius: 26rpx; display: flex; gap: 20rpx; padding: 20rpx; align-items: center; margin: 28rpx 0; }
.lock-card > image { width: 110rpx; height: 110rpx; }
.lock-card view { display: flex; flex-direction: column; gap: 8rpx; }
.favorite-link { margin-left: auto; font-size: 20rpx; }
.fitting-tools { margin-bottom: 18rpx; }
.compare-row { display: flex; gap: 24rpx; }
.compare-row > view { flex: 1; min-width: 0; }
.compare-row image { width: 100%; height: 380rpx; border-radius: 26rpx; background: #f0ede5; }
.compare-row text { display: block; font-size: 20rpx; color: #7b8178; margin-top: 8rpx; }
.selected-items { margin: 20rpx 0; }
.outfit-image.selected { background: #eaf0e6; border: 1rpx solid #b4c8b4; }
.task-preview { display: flex; gap: 20rpx; align-items: center; }
.task-images { display: flex; gap: 4rpx; width: 260rpx; height: 110rpx; }
.task-images image { flex: 1; min-width: 0; height: 100%; border-radius: 14rpx; background: #f8f7f2; }
.task-preview > view:last-child { flex: 1; display: flex; flex-direction: column; gap: 8rpx; font-size: 20rpx; }
.status-pill { border-radius: 14rpx; padding: 7rpx 12rpx; font-size: 18rpx; font-weight: 400; }
.status-pill.running { color: #a8794f; background: #f5eadf; }
.status-pill.done { color: #456b53; background: #eaf0e6; }
.task-result { width: 170rpx; height: 210rpx; border-radius: 20rpx; background: #f8f7f2; }
.task-footer { display: flex; justify-content: space-between; align-items: center; font-size: 20rpx; margin-top: 20rpx; }
.home-card { background: #eaf0e6; border-radius: 34rpx; padding: 24rpx; display: flex; align-items: center; gap: 20rpx; margin: 24rpx 0; }
.home-avatar { background: #fff; border-radius: 50%; width: 92rpx; height: 92rpx; display: flex; align-items: center; justify-content: center; }
.home-avatar image { width: 46rpx; height: 46rpx; }
.section-title-text { display: block; font-size: 30rpx; font-weight: 700; margin-bottom: 8rpx; }
.right-icon { margin-left: auto; width: 30rpx; height: 30rpx; }
.member-grid { display: flex; gap: 16rpx; }
.member-card { flex: 1; min-height: 130rpx; border-radius: 22rpx; border: 1rpx solid #e5e7de; background: #fff; padding: 18rpx; display: flex; flex-direction: column; gap: 6rpx; font-size: 20rpx; }
.member-card.selected { border-color: #456b53; background: #f0f5ed; }
.member-card .avatar { margin-bottom: 8rpx; }
.settings-list > view { min-height: 100rpx; gap: 14rpx; }
.settings-list > view > image, .settings-entry > image { width: 42rpx; height: 42rpx; padding: 10rpx; background: #f0f5ed; border-radius: 14rpx; flex: 0 0 auto; }
.settings-list > view > view, .settings-entry > view { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.usage-heading { border-bottom: 0 !important; min-height: auto !important; }
.usage-number { display: block; font-size: 50rpx; color: #456b53; font-weight: 700; margin: 12rpx 0; }
.usage-number text { font-size: 20rpx; color: #7b8178; font-weight: 400; }
.divider { height: 1rpx; background: #f0f1ec; margin: 20rpx 0; }
.settings-entry { border-bottom: 0 !important; }
.help-links { display: flex; justify-content: center; gap: 40rpx; color: #7b8178; font-size: 18rpx; padding: 24rpx 0; }
.bottom-nav { position: fixed; z-index: 30; bottom: 0; left: 0; right: 0; min-height: 128rpx; padding: 18rpx 0 18rpx; background: #fff; border-top: 1rpx solid #e5e7de; display: flex; align-items: flex-start; justify-content: space-around; border-radius: 28rpx 28rpx 0 0; }
.nav-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; color: #b4b9af; font-size: 19rpx; }
.nav-item image { width: 42rpx; height: 42rpx; opacity: .7; }
.nav-item.active { color: #456b53; font-weight: 700; }
.nav-item.active image { opacity: 1; }
.gesture-bar { position: absolute; bottom: 8rpx; left: 50%; transform: translateX(-50%); width: 240rpx; height: 8rpx; background: #29372f; border-radius: 10rpx; }
