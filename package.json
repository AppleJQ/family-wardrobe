{
  "name": "family-wardrobe",
  "version": "0.2.0",
  "private": true,
  "description": "小猪猪的家 · 家庭共享工具与家庭衣橱微信小程序",
  "scripts": {
    "check": "tsc --noEmit && node scripts/check-project.cjs",
    "typecheck": "tsc --noEmit",
    "build:cloud": "node scripts/build-cloud.cjs",
    "check:cloud": "tsc -p cloud/tsconfig.json --noEmit",
    "build:release": "node scripts/build-release.cjs",
    "dev:uni": "npm --prefix apps/uniapp run dev:h5",
    "check:uni": "npm --prefix apps/uniapp run typecheck",
    "build:uni": "node scripts/build-uniapp.cjs all",
    "build:uni:h5": "node scripts/build-uniapp.cjs h5",
    "build:uni:weixin": "node scripts/build-uniapp.cjs weixin",
    "build:uni:android": "node scripts/build-uniapp.cjs android",
    "build:uni:harmony": "node scripts/build-uniapp.cjs harmony"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pngjs": "6.0.5",
    "cos-nodejs-sdk-v5": "3.0.0",
    "jpeg-js": "0.4.4",
    "miniprogram-api-typings": "5.2.3",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "wx-server-sdk": "4.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
